{
  "name": "ai-lead-intelligence-crm",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "db:generate": "pnpm --filter @ai-crm/database prisma:generate",
    "build:packages": "pnpm --filter @ai-crm/config build && pnpm --filter @ai-crm/schemas build && pnpm --filter @ai-crm/shared build && pnpm --filter @ai-crm/database build",
    "pretest": "pnpm run db:generate && pnpm run build:packages",
    "test": "pnpm -r --if-present test",
    "pretypecheck": "pnpm run db:generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "prebuild": "pnpm run db:generate",
    "build": "pnpm -r --if-present build",
    "db:validate": "pnpm --filter @ai-crm/database prisma:validate",
    "db:migrate": "pnpm --filter @ai-crm/database prisma:migrate:dev",
    "db:deploy": "pnpm --filter @ai-crm/database prisma:migrate:deploy"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
